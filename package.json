{
  "name": "dsh-cyber-green-theme",
  "version": "1.0.1",
  "description": "CRT 赛博绿配色主题 for DSH：侧边栏/顶栏/输入框/浮层统一绿色 + 扫描线，输入框左侧小开关一键切换。基于设计令牌实现，新装插件自动跟随配色。建议搭配 dsh-claude-style（Nwflower，MIT，https://github.com/Nwflower/dsh-claude-style）使用：它提供排版与动效层。",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "theme",
    "cyberpunk",
    "green",
    "crt"
  ],
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg",
    "src",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/1165655527-dot/dsh-cyber-green-theme.git"
  },
  "homepage": "https://github.com/1165655527-dot/dsh-cyber-green-theme#readme",
  "bugs": {
    "url": "https://github.com/1165655527-dot/dsh-cyber-green-theme/issues"
  }
}
